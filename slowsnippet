package collection;
import java.util.*;

public class slowsnippet {

	public static void main(String[] args) {
		List<String> list = new ArrayList<>();
		for (int i = 0; i < 100000; i++) {
		    list.add("Item" + i);
		}
		for (int i = 0; i < list.size(); i++) {
		    if (list.get(i).startsWith("Item999")) {
		        System.out.println("Found");
		    }
		}


	}

}
